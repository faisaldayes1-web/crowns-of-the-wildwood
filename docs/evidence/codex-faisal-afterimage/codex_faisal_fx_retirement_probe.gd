				_pose_rows(sample, source_pose, true)
				var before_ids: Array = []
				for node in fx.get_children(): before_ids.append(node.get_instance_id())
				var life: float = 0.4 if capture else 0.15
				if not _checked_afterimage(sample, Color(0.6, 0.9, 1.0, 0.8), life):
					return false
				var ghost: Node3D
				for node in fx.get_children():
					if not before_ids.has(node.get_instance_id()): ghost = node
				var copied_pose: Array = []
				_pose_rows(ghost, copied_pose, false)
				var pose_error: float = _match_pose_rows(source_pose, copied_pose)
				_emit("matrix_snapshot", {"team":team, "role":role, "rank":rank, "source_id":sample.get_instance_id(), "ghost_id":ghost.get_instance_id(), "source_visible_meshes":source_pose.size(), "ghost_visible_meshes":copied_pose.size(), "max_transform_error":pose_error, "current_pose_match":pose_error>=0.0 and pose_error<=0.00001}, true)
				if pose_error < 0.0 or pose_error > 0.00001:
					_fail("Actual afterimage changed visible mesh resources/current world pose")
					return false
				if capture:
					sample.visible = false
					await RenderingServer.frame_post_draw
					if stopped: return false
					if not _capture_matrix(phase+"_ghost"):
						return false
				await create_timer(life+0.05).timeout
				await RenderingServer.frame_post_draw
				await RenderingServer.frame_post_draw
				if stopped: return false
				if fx.get_child_count() != 0:
					_fail("Actual matrix afterimage did not retire")
					return false
				_emit("matrix_retired", {"team":team, "role":role, "rank":rank, "fx_children":fx.get_child_count()}, true)
				sample.free()
				matrix_cases += 1
	if matrix_cases != 24 or matrix_pngs != 6 or afterimage_checks != 27:
		_fail("Incomplete24-case/6PNG/27ghost matrix")
		return false
	return true

func _pose_rows(node: Node, rows: Array, live_source: bool) -> void:
	if live_source and (node.is_queued_for_deletion() or node is AnimationPlayer or node is Label3D or node is GPUParticles3D or node is CPUParticles3D or node is Light3D):
		return
	if node is MeshInstance3D and node.is_visible_in_tree() and node.mesh != null and node.mesh.get_surface_count() > 0:
		rows.append({"mesh_id":node.mesh.get_instance_id(), "world":node.global_transform})
	for child in node.get_children(true): _pose_rows(child, rows, live_source)

func _match_pose_rows(source: Array, copy: Array) -> float:
	if source.is_empty() or source.size() != copy.size(): return -1.0
	var remaining: Array = copy.duplicate()
	var worst := 0.0
	for expected in source:
		var match_index := -1
		var closest := INF
		var a: Transform3D = expected.world
		for index in remaining.size():
			if expected.mesh_id != remaining[index].mesh_id: continue
			var b: Transform3D = remaining[index].world
			var error: float = maxf(maxf(a.origin.distance_to(b.origin), a.basis.x.distance_to(b.basis.x)), maxf(a.basis.y.distance_to(b.basis.y), a.basis.z.distance_to(b.basis.z)))
			if is_finite(error) and error < closest:
				closest = error
				match_index = index
		if match_index < 0: return -1.0
		worst = maxf(worst, closest)
		remaining.remove_at(match_index)
	return worst

func _capture_matrix(name: String) -> bool:
	var path: String = MATRIX_OUTPUT_DIR.path_join(name+".png")
	if FileAccess.file_exists(path):
		_fail("Refuse overwrite matrix PNG")
		return false
	var image: Image = root.get_texture().get_image()
	if image == null or image.is_empty() or image.save_png(path) != OK:
		_fail("Own viewport PNG write failed")
		return false
	matrix_pngs += 1
	_emit("matrix_png", {"path":path, "sha256":FileAccess.get_sha256(path), "width":image.get_width(), "height":image.get_height()}, true)
	return true


func _checked_afterimage(model: Node3D, color: Color, life: float) -> bool:
	var before_ids: Array = []
	for child in fx.get_children():
		before_ids.append(child.get_instance_id())
	fx.call("afterimage", model, color, life)
	var after_ids: Array = []
	var added: Array = []
	for child in fx.get_children():
		var id: int = child.get_instance_id()
		after_ids.append(id)
		if not before_ids.has(id):
			added.append(child)
	if added.size() != 1 or not added[0] is Node3D:
		_emit("afterimage_checked", {"before_ids":before_ids, "after_ids":after_ids, "new_children":added.size(), "valid":false}, true)
		_fail("Actual afterimage must create exactly one new Node3D ghost")
		return false
	var ghost: Node3D = added[0]
	var mesh_count := 0
	var visible_meshes := 0
	var unwanted: Array = []
	var mesh_ids: Array = []
	for node in ghost.find_children("*", "", true, false):
		if node is AnimationPlayer or node is Label3D or node is GPUParticles3D or node is CPUParticles3D or node is Light3D:
			unwanted.append({"id":node.get_instance_id(), "class":node.get_class()})
		if node is MeshInstance3D:
			mesh_count += 1
			mesh_ids.append(node.get_instance_id())
			if node.is_visible_in_tree() and node.mesh != null and node.mesh.get_surface_count() > 0:
				visible_meshes += 1
	var rows: Array = []
	_collect(ghost, rows)
	var valid: bool = visible_meshes > 0 and unwanted.is_empty()
	_emit("afterimage_checked", {"before_ids":before_ids, "after_ids":after_ids, "ghost_id":ghost.get_instance_id(), "ghost_path":str(ghost.get_path()), "mesh_ids":mesh_ids, "mesh_count":mesh_count, "visible_meshes":visible_meshes, "unwanted":unwanted, "resources":rows, "rows_capped":rows.size()>=MAX_ROWS, "valid":valid}, true)
	if not valid:
		_fail("Actual ghost lacks visible mesh or retains excluded simulation/label children")
		return false
	afterimage_checks += 1
	return true

func _flash(fraction: float) -> void:
	var unit_script: Variant = actor.get_script()
	actor.set("flash_timer", float(unit_script.FLASH_TIME)*fraction)
	actor.call("_flash_look") # Actual flash property mutations; no copied algorithm.

func _observe_added(node: Node) -> void:
	if stopped or not (node is MeshInstance3D or node is CPUParticles3D):
		return
	var ref: WeakRef = weakref(node)
	node.tree_exiting.connect(func(): _observe_exit(ref))
	_emit("geometry_added", {"node_id":node.get_instance_id(), "class":node.get_class(), "path":str(node.get_path())})

func _observe_exit(ref: WeakRef) -> void:
	var node = ref.get_ref()
	if node == null: return
	var rows: Array = []
	_describe_geometry(node, rows)
	_emit("geometry_tree_exiting", {"node_id":node.get_instance_id(), "class":node.get_class(), "resources":rows})

func _phase(name: String) -> void:
	phase = name
	var rows: Array = []
	# Current body first; old ghosts can otherwise fill the bounded snapshot.
	_collect(character, rows)
	_collect(fx, rows)
	_emit("phase", {"name":phase, "resources":rows, "rows_capped":rows.size()>=MAX_ROWS}, true)

func _collect(node: Node, rows: Array) -> void:
	if rows.size() >= MAX_ROWS: return
	_describe_geometry(node, rows)
	for child in node.get_children():
		if rows.size() >= MAX_ROWS: return
		_collect(child, rows)

func _describe_geometry(node: Node, rows: Array) -> void:
	var mesh: Mesh
	if node is MeshInstance3D or node is CPUParticles3D:
		mesh = node.mesh
		_record(node.material_override, "override", node, rows)
	if mesh != null:
		_record(mesh, "mesh", node, rows)
		for index in range(mesh.get_surface_count()):
			var material: Material = mesh.surface_get_material(index)
			_record(material, "mesh_surface"+str(index), node, rows)
			if node is MeshInstance3D:
				if index < node.get_surface_override_material_count():
					_record(node.get_surface_override_material(index), "surface_override"+str(index), node, rows)
				_record(node.get_active_material(index), "active_surface"+str(index), node, rows)

func _record(resource: Object, kind: String, owner_node: Node, rows: Array) -> void:
	if resource == null or rows.size() >= MAX_ROWS: return
	var handle: RID = resource.call("get_rid") # Only actual Mesh/Material callers.
	var info := {"kind":kind, "node_id":owner_node.get_instance_id(), "path":str(owner_node.get_path()), "class":resource.get_class(), "instance_id":resource.get_instance_id(), "rid_handle_not_storage_validity":handle.get_id()}
	rows.append(info)
	var id: int = resource.get_instance_id()
	if not seen.has(id) and tracked.size() < MAX_ROWS:
		seen[id] = true
		tracked.append({"weak":weakref(resource), "info":info.duplicate()})
	if resource is Material and resource.next_pass != null:
		_record(resource.next_pass, "next_pass", owner_node, rows)

func _report_weak(name: String) -> void:
	var rows: Array = []
	for item in tracked:
		var info: Dictionary = item.info.duplicate()
		info.weak_alive = item.weak.get_ref() != null
		rows.append(info)
	_emit(name, {"resources":rows, "note":"WeakRef alive is not rendering-storage RID validity; no integer RID reused."}, true)

func _process(_delta: float) -> bool:
	if not stopped and Time.get_ticks_msec()-started_ms >= LIMIT_MS:
		_fail("35second diagnostic ceiling")
	return false

func _emit(operation: String, fields: Dictionary, required: bool=false) -> void:
	if not required and event_count >= MAX_EVENTS:
		events_dropped += 1
		return
	event_count += 1
	fields.op = operation
	fields.phase = phase
	fields.pid = OS.get_process_id()
	fields.elapsed_ms = Time.get_ticks_msec()-started_ms
	fields.unix_seconds = Time.get_unix_time_from_system()
	fields.process_frame = Engine.get_process_frames()
	fields.draw_count = draw_count
	print("C1_FX_RETIREMENT "+JSON.stringify(fields))

func _fail(reason: String) -> void:
	if stopped: return
	stopped = true
	_emit("terminal", {"status":"FAILED", "reason":reason, "exit_requested":3, "events_dropped":events_dropped}, true)
	if is_instance_valid(world): world.free()
	if is_instance_valid(actor): actor.free()
	if is_instance_valid(toon_game): toon_game.free()
	quit(3)

func _path(value: String) -> String:
	return value.replace("\\", "/").simplify_path().trim_suffix("/").to_lower()
